      "required": [
        "centre_id",
        "name",
        "centre_identity",
        "centre_anchor",
        "anchor_kind",
        "anchor_coordinates",
        "crs",
        "address",
        "address_conflict",
        "human_review_required",
        "modelled_network_access",
        "entrance_verification",
        "entrance_verified",
        "modelled_access",
        "door_to_door",
        "source_refs",
        "wording"
      ],
      "additionalProperties": false
    },
