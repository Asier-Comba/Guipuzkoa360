              "date",
              "appointment_time",
              "duration_minutes",
              "arrival_margin_minutes",
              "boarding_margin_minutes",
              "walking_profile_id",
              "snapshot_id",
              "return_deadline",
              "timezone"
            ]
          }
        },
        "total_difference_s": {
