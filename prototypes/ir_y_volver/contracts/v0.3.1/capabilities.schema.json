        },
        "modelled_access": {
          "type": "boolean"
        },
        "entrance_verified": {
          "const": false
        },
        "origins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validated_dates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "walking_profile_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "snapshot_id",
        "contract_version",
        "scenario_kind",
        "scope",
        "destination_semantics",
        "modelled_access",
        "entrance_verified",
        "origins",
        "destinations",
        "validated_dates",
        "walking_profile_id"
      ],
      "additionalProperties": false
    },
    "ComparisonPair": {
      "type": "object",
      "properties": {
        "left_index": {
          "type": "integer",
          "minimum": 0
        },
        "right_index": {
          "type": "integer",
          "minimum": 0
        },
        "comparability": {
          "enum": [
            "comparable",
            "not_comparable"
          ]
        },
        "requested_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "enum": [
                  "origin_id",
                  "destination_id",
                  "date",
                  "appointment_time",
                  "duration_minutes",
                  "arrival_margin_minutes",
                  "boarding_margin_minutes",
                  "walking_profile_id",
                  "snapshot_id",
                  "return_deadline",
                  "timezone"
                ]
              },
              "left": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "right": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "field",
              "left",
              "right"
