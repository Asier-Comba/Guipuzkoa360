        "address_conflict": {
          "enum": [
            "same_entity_same_site",
            "same_entity_different_service_address",
            "historical_address",
            "conflicting_current_sources",
            "unresolved"
          ]
        },
        "human_review_required": {
          "type": "boolean"
        },
        "modelled_network_access": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "entrance_verification": {
          "const": "NOT_VERIFIED"
        },
        "entrance_verified": {
          "const": false
        },
        "modelled_access": {
          "const": true
        },
        "door_to_door": {
          "const": "UNAVAILABLE"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wording": {
          "type": "string",
          "minLength": 1
        }
