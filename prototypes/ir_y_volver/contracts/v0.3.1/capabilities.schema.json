        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "enum": [
            "0.2.0",
            "0.3.1"
          ]
        },
        "scenario_kind": {
          "enum": [
            "stop_only",
            "health_visit"
          ]
        },
        "scope": {
          "const": "origin_stop_presence_to_return_stop_arrival"
        },
        "destination_semantics": {
          "enum": [
            "stop_only",
            "official_centre_point_not_verified_entrance"
