                  "type": "integer",
                  "minimum": 0
                },
                "destination_walk_outbound_s": {
                  "type": "integer",
                  "minimum": 0
                },
                "pre_appointment_wait_s": {
                  "type": "integer",
                  "minimum": 0
                },
                "appointment_s": {
                  "type": "integer",
                  "minimum": 0
                },
                "destination_walk_return_s": {
                  "type": "integer",
                  "minimum": 0
                },
                "return_wait_s": {
                  "type": "integer",
                  "minimum": 0
