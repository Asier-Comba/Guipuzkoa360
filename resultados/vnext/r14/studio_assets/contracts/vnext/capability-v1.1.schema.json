{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Asier-Comba/Guipuzkoa360/blob/work/vnext-w2-agent-evidence/contracts/vnext/capability-v1.1.schema.json",
  "title": "GIPUZKOA 360 W2 Capability 1.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "description", "derivation", "enabled", "validation_status", "handler", "input_fields", "required_data", "coverage", "source_ids", "allowed_transformations", "preconditions", "precondition_checks", "validation_evidence", "restrictions", "semantic_limits"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
    "derivation": {"enum": ["direct", "derived_exact", "estimated_with_assumptions", "unavailable"]},
    "enabled": {"type": "boolean"}, "validation_status": {"enum": ["tested", "pending", "failed"]},
    "handler": {"type": ["string", "null"]},
    "input_fields": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "type", "required", "allowed_values"], "properties": {"name": {"type": "string", "minLength": 1}, "type": {"enum": ["string", "number", "integer", "boolean", "string_array", "object_or_array"]}, "required": {"type": "boolean"}, "allowed_values": {"type": "array", "items": {"type": ["string", "number", "integer", "boolean"]}}}}},
    "required_data": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["territory", "periods", "entities", "scope"], "properties": {"territory": {"type": "string", "minLength": 1}, "periods": {"type": "array", "items": {"type": "string", "minLength": 1}}, "entities": {"type": "integer", "minimum": 0}, "scope": {"type": "string", "minLength": 1}}},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_transformations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "precondition_checks": {"type": "array", "uniqueItems": true, "items": {"enum": ["required_data_sha256", "handler_signature", "source_catalog", "coverage_count"]}},
    "validation_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["test_file", "test_name", "sha256"], "properties": {"test_file": {"type": "string", "minLength": 1}, "test_name": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "restrictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "semantic_limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"validation_status": {"const": "tested"}, "handler": {"type": "string", "minLength": 1}, "required_data": {"minItems": 1}, "source_ids": {"minItems": 1}, "precondition_checks": {"minItems": 1}, "validation_evidence": {"minItems": 1}}}},
    {"if": {"properties": {"derivation": {"const": "unavailable"}}}, "then": {"properties": {"enabled": {"const": false}}}}
  ]
}
